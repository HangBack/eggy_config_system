{
  "name": "Skill",
  "description": "技能配置表",
  "fields": [
    {
      "name": "id",
      "label": "技能ID",
      "type": "number",
      "defaultValue": "1",
      "required": true
    },
    {
      "name": "name",
      "label": "技能名称",
      "type": "text",
      "defaultValue": "",
      "required": true,
      "isRaw": false
    },
    {
      "name": "category",
      "label": "技能类别",
      "type": "option",
      "defaultValue": "",
      "required": true,
      "isRaw": true,
      "dataSource": {
        "type": "enum",
        "enum": "SkillCategory",
        "enumPrefix": "Enum.SkillCategory"
      }
    },
    {
      "name": "cooldown",
      "label": "冷却时间(秒)",
      "type": "number",
      "defaultValue": "5",
      "required": true
    },
    {
      "name": "manaCost",
      "label": "魔法消耗",
      "type": "number",
      "defaultValue": "10",
      "required": true
    },
    {
      "name": "effectColor",
      "label": "特效颜色",
      "type": "color",
      "defaultValue": "#00FF00",
      "required": false
    },
    {
      "name": "targets",
      "label": "目标选择",
      "type": "datalist",
      "defaultValue": "",
      "required": true,
      "isRaw": false,
      "dataSource": {
        "type": "manual"
      },
      "options": [
        {"value": "self", "label": "自身"},
        {"value": "single_enemy", "label": "单个敌人"},
        {"value": "all_enemies", "label": "所有敌人"},
        {"value": "single_ally", "label": "单个队友"},
        {"value": "all_allies", "label": "所有队友"}
      ]
    },
    {
      "name": "damageValues",
      "label": "伤害倍率(按等级)",
      "type": "list",
      "defaultValue": [],
      "required": false,
      "isRaw": false,
      "elementType": "number"
    },
    {
      "name": "requirements",
      "label": "学习条件",
      "type": "entry",
      "defaultValue": [],
      "required": false,
      "subfields": [
        {
          "name": "level",
          "label": "需求等级",
          "type": "number",
          "defaultValue": "1"
        },
        {
          "name": "preSkill",
          "label": "前置技能",
          "type": "datalist",
          "defaultValue": "",
          "isRaw": false,
          "dataSource": {
            "type": "linked",
            "schema": "Skill"
          }
        }
      ]
    }
  ],
  "exportConfig": {
    "namespace": "Config",
    "requires": ["Enum.SkillCategory"]
  }
}
